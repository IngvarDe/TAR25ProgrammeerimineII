@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>

@{
    int rowNumber = 1;
}

<div>
    <a asp-action="create" asp-controller="Spaceship" type="submit" class="btn btn-primary">Create</a>
</div>

<div class="h1">
    Spaceship
</div>
<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spaceship in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@spaceship.Name</td>
                        <td>@spaceship.Classification</td>
                        <td>@spaceship.BuiltDate</td>
                        <td>@spaceship.Crew</td>
                        <td>
                            <a asp-action="details" asp-controller="Spaceship" asp-route-id="@spaceship.Id" type="submit" class="btn btn-info">Details</a>
                        <a asp-action="update" asp-controller="Spaceship" asp-route-id="@spaceship.Id" type="submit" class="btn btn-success">Update</a>
                        <a asp-action="delete" asp-controller="Spaceship" asp-route-id="@spaceship.Id" type="submit" class="btn btn-danger">Delete</a>

                        </td>
                    </tr>
                    rowNumber++;
                }
        </tbody>
    </table>
</form>