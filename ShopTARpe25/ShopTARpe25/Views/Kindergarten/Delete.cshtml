@model ShopTARpe25.Models.Kindergarten.KindergartenDeleteViewModel

<h1>Delete</h1>

<h3>Are you sure you want to delete this kindergarten?</h3>

<div>
    <h4>Kindergarten</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Group Name</dt>
        <dd class="col-sm-10">@Model.GroupName</dd>

        <dt class="col-sm-2">Children Count</dt>
        <dd class="col-sm-10">@Model.ChildrenCount</dd>

        <dt class="col-sm-2">Kindergarten Name</dt>
        <dd class="col-sm-10">@Model.KindergartenName</dd>

        <dt class="col-sm-2">Teacher Name</dt>
        <dd class="col-sm-10">@Model.TeacherName</dd>

        <dt class="col-sm-2">CreatedAt</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>

        <dt class="col-sm-2">UpdatedAt</dt>
        <dd class="col-sm-10">@Model.UpdatedAt</dd>
    </dl>

    <form asp-action="DeleteConfirmation" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
