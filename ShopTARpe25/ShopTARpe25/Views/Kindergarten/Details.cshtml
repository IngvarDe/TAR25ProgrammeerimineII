@model ShopTARpe25.Models.Kindergarten.KindergartenDetailsViewModel

<h1>Details</h1>

<div>
    <h4>Kindergarten</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Group Name</dt>
        <dd class="col-sm-10">@Model.GroupName</dd>

        <dt class="col-sm-2">Children Count</dt>
        <dd class="col-sm-10">@Model.ChildrenCount</dd>

        <dt class="col-sm-2">Kindergarten Name</dt>
        <dd class="col-sm-10">@Model.KindergartenName</dd>

        <dt class="col-sm-2">Teacher Name</dt>
        <dd class="col-sm-10">@Model.TeacherName</dd>

        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">@Model.CreatedAt</dd>

        <dt class="col-sm-2">Updated At</dt>
        <dd class="col-sm-10">@Model.UpdatedAt</dd>
    </dl>

    <h4>Images</h4>

    @foreach (var image in Model.FileToApiDtos)
    {
        <div>
            <img src="~/multipleFileUpload/@image.ExistingFilePath"
                 alt="Kindergarten image"
                 style="max-width: 300px; margin: 10px;" />
        </div>
    }

    <a asp-action="Index" asp-controller="Kindergarten" class="btn btn-danger">
        Back to List
    </a>
</div>
